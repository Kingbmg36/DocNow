# DocNow.NG frontend config.
# REACT_APP_* are baked in at BUILD time by Create React App — set them before `yarn build`
# (on Railway, set them as service variables so they're present during the Docker build).

# Public URL of the backend service (no trailing slash). The app calls `${REACT_APP_BACKEND_URL}/api`.
REACT_APP_BACKEND_URL=https://your-backend.up.railway.app

# Dev-only (local `yarn start`); ignored in production builds:
# WDS_SOCKET_PORT=443
# ENABLE_HEALTH_CHECK=false
