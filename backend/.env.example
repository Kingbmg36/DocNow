# DocNow.NG backend configuration — copy to .env and fill in.
# NEVER commit the real .env (it holds live secrets). This example carries no secrets.

# ---- Database ----
MONGO_URL=mongodb://localhost:27017
DB_NAME=docnow_db

# ---- App ----
CORS_ORIGINS=*
JWT_SECRET=change-me-to-a-long-random-string
FRONTEND_URL=http://localhost:3000
SEED_WIPE=false
DEV_OTP_REVEAL=true

# ---- Seed admin ----
ADMIN_EMAIL=admin@docnow.ng
ADMIN_PASSWORD=Admin@123

# ---- AI (Anthropic Claude) ----
ANTHROPIC_API_KEY=
# Model to use. Default claude-opus-4-8 (most capable). Set claude-sonnet-5 to cut cost.
ANTHROPIC_MODEL=claude-opus-4-8

# ---- Paystack payments ----
# Stub mode (default) needs no keys. To go live: PAYSTACK_ENABLED=true + a secret key.
# Test keys (sk_test_… / pk_test_…) work end-to-end against Paystack's test mode.
PAYSTACK_ENABLED=false
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Paystack redirects here after checkout; defaults to FRONTEND_URL/patient when blank.
PAYSTACK_CALLBACK_URL=
# Webhook URL to register in the Paystack dashboard:
#   https://<your-backend-host>/api/payments/webhook

# ---- Object storage (doctor license documents) ----
# local (default) writes under STORAGE_LOCAL_DIR (defaults to backend/uploads).
# s3 needs STORAGE_S3_BUCKET + AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY (boto3 env).
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=us-east-1
STORAGE_S3_ENDPOINT=

# ---- Email (Resend) ----
# Stub mode (default) logs instead of sending. To send: EMAIL_ENABLED=true + key.
EMAIL_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM=DocNow.NG <no-reply@docnow.ng>

# ---- SMS (Termii) — primary OTP delivery channel ----
# Stub mode (default) logs instead of sending. To send: SMS_ENABLED=true + key.
# Get a key + sender ID at termii.com; sender ID needs approval for live sends.
SMS_ENABLED=false
TERMII_API_KEY=
TERMII_SENDER_ID=DocNow

# ---- WhatsApp Cloud API ----
WHATSAPP_ENABLED=false
WHATSAPP_API_VERSION=v22.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
